<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#B39BFF" android:endColor="#775CFF"/>
            <stroke android:width="3dp" android:color="#E6DFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#A48AFF" android:endColor="#684EFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#7D5CFF" android:endColor="#6046E6"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
